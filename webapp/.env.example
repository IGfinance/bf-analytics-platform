# Ключ подписи сессий Flask-Login — сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me
WEBAPP_PORT=5001

# Внешний путь, под которым nginx проксирует приложение (пусто = корень).
# На проде report.finance-black.ru — /cloudsix (см. location /cloudsix/ в nginx).
URL_PREFIX=
