# ClickHouse self-hosted на прод-VPS, слушает только 127.0.0.1:8123.
# Для локальной разработки поднимите SSH-туннель:
#   ssh -L 8123:127.0.0.1:8123 root@<host>
#
# Разграничение проектов (2026-09-12): одна БД = один проект, имя БД
# совпадает с projects.slug (control-БД — общеплатформенные projects/
# users/user_projects, см. src/schema_control.sql и src/ch_control.py).
# CLICKHOUSE_DATABASE — БД проекта, с которым работают CLI-скрипты
# (webapp резолвит БД динамически по /p/<slug>/, см. get_client(database=...)
# в webapp/app.py). См. .claude/plans/iridescent-brewing-scroll.md.
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_DATABASE=cloudsix
CLICKHOUSE_SECURE=0

# Данные сервера для finance-black.ru (root SSH, только для деплой-скриптов)
DEPLOY_SSH_HOST=your_server_ip
DEPLOY_SSH_USER=root
DEPLOY_SSH_PASSWORD=your_password_here

# Google Sheets (Реальт — вкладка «Импорт ФОТ» через сервис-аккаунт).
# GSHEETS_SA_KEY — путь к JSON-ключу SA (относительно корня репозитория или
# абсолютный); файл не коммитится (secrets/ в .gitignore), на сервере — секрет.
GSHEETS_SA_KEY=secrets/gsheets-sa.json
GSHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
